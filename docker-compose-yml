services:
  api:
    build: .
    container_name: ibge_api
    ports:
      - "8000:8000"
    env_file:
      - .env
    depends_on:
      - db

  db:
    image: postgres:16
    container_name: ibge_postgres
    environment:
      POSTGRES_DB: ibge
      POSTGRES_USER: ibge
      POSTGRES_PASSWORD: ibge_password
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data: